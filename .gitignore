# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
*.bak

# ── Database / vector store ───────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/vault/*.db
data/docs/*.db

# ── Data / Documents ──────────────────────────────────────────────────────────
# Ignore everything in data/vault and data/docs except .gitkeep
data/vault/*
!data/vault/.gitkeep
data/docs/*
!data/docs/.gitkeep

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/node_modules/
frontend/.cache/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.suo
*.user
